---
import { getEntry } from 'astro:content';
import { type LanguageKey } from '@/i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils';
import { withBase } from '@/utils/base';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';

const config = await getEntry('config', 'site');
if (!config) throw new Error('Missing "site" entry in the config collection.');

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const { brand } = config.data;

const skills = [
	{ label: 'Programming & web', value: 'Python, C++, JavaScript, React' },
	{ label: 'AI & ML', value: 'Model evaluation, data visualization, AI applications' },
	{ label: 'Systems', value: 'Linux, Docker, Git, self-hosted services, Vercel' },
	{ label: 'Hardware', value: 'Arduino, IoT, 3D printing, photogrammetry, simulations' },
];

const projects = [
	{ name: 'SystemStats', body: 'A Python terminal monitor with resource tracking and PDF reports.', url: 'https://github.com/Googoochadwick/SystemStats' },
	{ name: 'Blood Cell Anomaly Prediction', body: 'ML models and a Streamlit app for blood cell anomaly detection.' },
	{ name: 'SynRoute', body: 'An AI model routing tool comparing accuracy, speed and cost.' },
];

const experience = [
	{ role: 'Machine Learning Intern', organization: 'Digipodium', date: 'June–July 2026', body: 'Built, evaluated and deployed blood cell anomaly prediction models.' },
];

const leadership = [
	'Vice-President — Geek Room Club, SRM IST',
	'Lead Electrical & Simulations Engineer — Nodus Racing',
	'Innovation Ambassador — SRM',
	'Former leadership responsibilities — Academies Council, Delhi Public School',
];

const certifications = [
	{ name: 'Microsoft Certified: Azure Fundamentals (AZ-900)', image: '/microsoft.png', alt: 'Microsoft Azure Fundamentals certificate' },
	{ name: 'Microsoft Certified: Azure AI Fundamentals (AI-900)', image: '/microsoft.png', alt: 'Microsoft Azure AI Fundamentals certificate' },
	{ name: 'Harvard CS50P', image: '/harvard.png', alt: 'Harvard CS50P certificate' },
];
const achievements = [
	'Vividglyph 2.0 — Second Place',
	'Algo2Arduino — First',
	'Connect SRM Hackathon — Runner-up',
];

const copy: Record<LanguageKey, { kicker: string; title: string; description: string; intro: string }> = {
	en: {
		kicker: 'About Me / 01',
		title: 'Hello There!',
		description: 'I’m Arush Anand Singh, a computer science student at SRM IST Ghaziabad who likes understanding systems and building across software, hardware and infrastructure.',
		intro: 'I’m Arush Anand Singh, a Computer Science student at SRM IST Ghaziabad (2024–2028) who enjoys building across software, hardware and infrastructure. I work mainly with Python, C++, machine learning and Linux, turning ideas into practical projects while learning something new along the way.',
	},
};

const content = copy[lang];
const logo = (path: string) => withBase(path);
---

<BaseLayout title={`${brand.name} — ${content.kicker}`} description={content.description}>
	<main class="px-4 pb-12 pt-6">
		<div class="max-w-4xl">
			<p class="label">{content.kicker}</p>
			<h1 class="mt-4 flex max-w-3xl items-center gap-3 text-4xl leading-[0.98] tracking-[-0.045em] sm:text-5xl md:text-6xl">
				<img src={logo('/white-polo.png')} alt="" class="h-14 w-14 rounded-full object-cover object-top sm:h-16 sm:w-16 md:h-20 md:w-20" />
				<span>{content.title}</span>
			</h1>
			<div class="mt-8">
				<p class="max-w-2xl text-lg leading-relaxed text-muted md:text-xl">{content.intro}</p>
				<p class="mt-4 flex flex-wrap gap-x-4 gap-y-1">
					<a class="label text-ink" href="https://www.linkedin.com/in/arush-anand-singh-googoochadwick/">LinkedIn ↗</a>
					<a class="label text-ink" href="https://www.geekroom-srmist.co.in/team">Geekroom Club ↗</a>
					<a class="label text-ink" href="https://rx.cv/googoochadwick" target="_blank" rel="noopener noreferrer">Résumé ↗</a>
				</p>
			</div>

			<section class="mt-12 grid gap-x-12 gap-y-10 md:grid-cols-2" aria-label="Skills and projects">
				<article class="border-t border-line pt-4">
					<p class="label">💻 Technical skills</p><h2 class="mt-3 text-2xl">A few tools in my kit</h2>
					<dl class="mt-4 space-y-3 text-base leading-relaxed text-muted">{skills.map((s) => <div><dt class="label mb-1 block text-xs text-muted">{s.label}</dt><dd>{s.value}</dd></div>)}</dl>
					<p class="mt-4"><a class="label text-ink" href="https://ishortn.ink/my-github">My code repositories ↗</a></p>
				</article>
				<article class="border-t border-line pt-4">
					<p class="label">🦾 Projects</p><h2 class="mt-3 text-2xl">Things I’ve been building</h2>
					<ul class="mt-4 list-none space-y-4">{projects.map((project) => <li><h3 class="text-lg">{project.name}</h3><p class="mt-1 leading-relaxed text-muted">{project.body}</p>{project.url && <a class="label mt-1 inline-block text-ink" href={project.url}>GitHub repository ↗</a>}</li>)}</ul>
				</article>
				<article class="border-t border-line pt-4">
					<p class="label">👨‍💻 Experience</p><h2 class="mt-3 text-2xl">Learning by doing</h2>
					<ul class="mt-4 list-none space-y-5">{experience.map((item) => <li><p class="label">{item.date}</p><h3 class="mt-1 text-lg">{item.role} · {item.organization}</h3><p class="mt-2 leading-relaxed text-muted">{item.body}</p></li>)}</ul>
				</article>
				<article class="border-t border-line pt-4">
					<p class="label">👔 Leadership</p><h2 class="mt-3 text-2xl">Building with people</h2>
					<ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed text-muted">{leadership.map((item) => <li>{item}</li>)}</ul>
				</article>
				<article class="border-t border-line pt-4 md:col-span-2">
					<p class="label">📜 Certifications</p><h2 class="mt-3 text-2xl">Things I’ve studied</h2>
					<ul class="mt-4 grid gap-6 sm:grid-cols-3">{certifications.map((certification) => <li><img src={logo(certification.image)} alt={certification.alt} class="h-24 w-auto object-contain" loading="lazy" /><p class="mt-3 leading-relaxed">{certification.name}</p></li>)}</ul>
				</article>
				<article class="border-t border-line pt-4 md:col-span-2">
					<p class="label">🏆 Achievements</p><h2 class="mt-3 text-2xl">A few milestones</h2>
					<ul class="mt-4 grid list-disc gap-x-12 gap-y-2 pl-5 leading-relaxed text-muted sm:grid-cols-2">{achievements.map((item) => <li>{item}</li>)}</ul>
				</article>
				<article class="border-t border-line pt-4">
					<p class="label">🌐 Find me on</p><h2 class="mt-3 text-2xl">Socials</h2>
					<ul class="mt-4 list-disc space-y-3 pl-5 leading-relaxed sm:space-y-1">{brand.socials.map((s) => <li><a class="text-ink" href={s.url}>{s.name} ↗</a></li>)}</ul>
				</article>
				<article class="border-t border-line pt-4">
					<p class="label">✍️ Writing</p><h2 class="mt-3 text-2xl">A little bit of everything</h2>
					<p class="mt-4 leading-relaxed text-muted">Notes on software, AI/ML experiments, Linux and self-hosting, hardware tinkering and design.</p>
					<p class="mt-4"><a class="label text-ink" href={`${translatePath('/posts')}/`}>Read the posts <span aria-hidden="true">↗</span></a></p>
				</article>
			</section>
		</div>
		<Giscus />
	</main>
</BaseLayout>
