---
import { getEntry } from 'astro:content';
import { type LanguageKey } from '@/i18n/ui';
import { getLangFromUrl, useTranslatedPath } from '@/i18n/utils';
import { withBase } from '@/utils/base';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Giscus from '@/components/Giscus.astro';

const config = await getEntry('config', 'site');
if (!config) throw new Error('Missing "site" entry in the config collection.');

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const { brand } = config.data;

const skills = [
	{ label: 'Programming', value: 'Python, C++, JavaScript, React' },
	{ label: 'AI & ML', value: 'Model evaluation, data analysis, AI applications' },
	{ label: 'Systems', value: 'Linux, Docker, Git, self-hosting, Vercel' },
	{ label: 'Hardware', value: 'Arduino, IoT, 3D printing, photogrammetry' },
];

const projects = [
	{ name: 'SystemStats', body: 'A Python terminal monitor with resource tracking and PDF reports.', url: 'https://github.com/Googoochadwick/SystemStats' },
	{ name: 'Blood Cell Anomaly Prediction', body: 'ML models and a Streamlit app for blood cell anomaly detection.' },
	{ name: 'SynRoute', body: 'An AI model routing tool comparing accuracy, speed and cost.' },
];

const experience = [
	{ role: 'Machine Learning Intern', organization: 'Digipodium', date: 'June–July 2026', body: 'Built, evaluated and deployed blood cell anomaly prediction models.' },
];

const leadership = [
	'Vice-President — Geek Room, SRM IST',
	'Lead Electrical & Simulations Engineer — Nodus Racing',
	'Innovation Ambassador — SRM',
];

const certifications = [
	{
		name: 'Microsoft Certified: Azure Fundamentals (AZ-900)',
		image: '/microsoft.png',
		alt: 'Microsoft Azure Fundamentals certificate',
		url: 'https://learn.microsoft.com/en-us/users/arushanandsingh-0374/credentials/dfc4be24c786d14f?ref=https%3A%2F%2Fwww.linkedin.com%2F',
	},
	{
		name: 'Microsoft Certified: Azure AI Fundamentals (AI-900)',
		image: '/microsoft.png',
		alt: 'Microsoft Azure AI Fundamentals certificate',
		url: 'https://learn.microsoft.com/en-us/users/arushanandsingh-0374/credentials/3e6491c874db4d1e?ref=https%3A%2F%2Fwww.linkedin.com%2F',
	},
	{
		name: 'Harvard CS50P',
		image: '/harvard.png',
		alt: 'Harvard CS50P certificate',
		url: 'https://certificates.cs50.io/2d78657b-2231-415e-9a90-ba18d00b2d49.pdf?size=letter',
	},
];
const achievements = [
	'Vividglyph 2.0 — Second Place',
	'Algo2Arduino — First Place',
	'Connect SRM Hackathon — First Runner-up',
];

const copy: Record<LanguageKey, { kicker: string; title: string; description: string; intro: string }> = {
	en: {
		kicker: 'About Me / 01',
		title: 'Hello There!',
		description: 'I’m Arush Anand Singh, a computer science student at SRM IST Ghaziabad who likes understanding systems and building across software, hardware and infrastructure.',
		intro: 'I’m Arush Anand Singh, a Computer Science student at SRM IST Ghaziabad. I build across software, hardware and infrastructure—with Python, C++, machine learning and Linux.',
	},
};

const content = copy[lang];
const logo = (path: string) => withBase(path);
---

<BaseLayout title={`${brand.name} — ${content.kicker}`} description={content.description}>
	<main class="mx-auto w-full max-w-5xl px-5 pb-16 pt-8 sm:px-8">
		<div>
			<div class="grid items-start gap-8 sm:grid-cols-[1fr_auto]">
				<div>
					<p class="label text-muted">{content.kicker}</p>
					<div class="mt-5 flex items-center gap-4">
						<img src={logo('/white-polo.png')} alt="Arush Anand Singh" class="h-16 w-16 shrink-0 rounded-full object-cover object-top sm:h-20 sm:w-20" />
						<h1 class="text-4xl leading-none tracking-[-0.05em] sm:text-5xl">{content.title}</h1>
					</div>
					<p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">{content.intro}</p>
					<nav class="mt-5 flex flex-wrap gap-x-5 gap-y-2" aria-label="About links">
						<a class="label border-b border-line pb-1 text-ink" href="https://www.linkedin.com/in/arush-anand-singh-googoochadwick/">LinkedIn ↗</a>
						<a class="label border-b border-line pb-1 text-ink" href="https://www.geekroom-srmist.co.in/team">Geekroom ↗</a>
						<a class="label border-b border-line pb-1 text-ink" href="https://rx.cv/googoochadwick" target="_blank" rel="noopener noreferrer">Résumé ↗</a>
					</nav>
				</div>
			</div>

			<section class="mt-16 grid gap-x-12 gap-y-12 md:grid-cols-2" aria-label="About details">
				<article class="border-t border-line pt-4">
					<h2 class="text-xl">Technical skills</h2>
					<dl class="mt-4 space-y-3 text-base leading-relaxed text-muted">{skills.map((s) => <div><dt class="label mb-1 block text-xs text-muted">{s.label}</dt><dd>{s.value}</dd></div>)}</dl>
					<p class="mt-4"><a class="label text-ink" href="https://ishortn.ink/my-github">My code repositories ↗</a></p>
				</article>
				<article class="border-t border-line pt-4">
					<h2 class="text-xl">Projects</h2>
					<ul class="mt-4 space-y-5">{projects.map((project) => <li><h3 class="text-base">{project.name}</h3><p class="mt-1 text-sm leading-relaxed text-muted">{project.body}</p>{project.url && <a class="label mt-1 inline-block text-ink" href={project.url}>GitHub ↗</a>}</li>)}</ul>
				</article>
				<article class="border-t border-line pt-4">
					<h2 class="text-xl">Experience</h2>
					<ul class="mt-4 space-y-5">{experience.map((item) => <li><p class="label text-muted">{item.date}</p><h3 class="mt-1 text-base">{item.role} · {item.organization}</h3><p class="mt-2 text-sm leading-relaxed text-muted">{item.body}</p></li>)}</ul>
				</article>
				<article class="border-t border-line pt-4">
					<h2 class="text-xl">Leadership</h2>
					<ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed text-muted">{leadership.map((item) => <li>{item}</li>)}</ul>
				</article>
				<article class="border-t border-line pt-4">
					<h2 class="text-xl">Certifications</h2>
					<ul class="mt-5 grid list-none gap-6 sm:grid-cols-2">{certifications.map((certification) => <li><a href={certification.url} target="_blank" rel="noopener noreferrer" aria-label={`View ${certification.name}`}><img src={logo(certification.image)} alt={certification.alt} class="h-16 w-auto object-contain" loading="lazy" /><p class="mt-3 text-sm leading-relaxed text-muted">{certification.name} ↗</p></a></li>)}</ul>
				</article>
				<article class="border-t border-line pt-4">
					<h2 class="text-xl">Achievements</h2>
					<ul class="mt-4 grid list-disc gap-x-8 gap-y-2 pl-5 leading-relaxed text-muted sm:grid-cols-2">{achievements.map((item) => <li>{item}</li>)}</ul>
				</article>
				<article class="border-t border-line pt-4">
					<h2 class="text-xl">Socials</h2>
					<ul class="mt-4 list-disc space-y-3 pl-5 leading-relaxed sm:space-y-1">{brand.socials.map((s) => <li><a class="text-ink" href={s.url}>{s.name} ↗</a></li>)}</ul>
				</article>
				<article class="border-t border-line pt-4">
					<h2 class="text-xl">Writing</h2>
					<p class="mt-4 leading-relaxed text-muted">Notes on software, AI/ML experiments, Linux and self-hosting, hardware tinkering and design.</p>
					<p class="mt-4"><a class="label text-ink" href={`${translatePath('/posts')}/`}>Read the posts <span aria-hidden="true">↗</span></a></p>
				</article>
			</section>
		</div>
		<Giscus />
	</main>
</BaseLayout>
