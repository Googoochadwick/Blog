---
import CategoryNav from "@/components/CategoryNav.astro";
import Giscus from "@/components/Giscus.astro";
import Mermaid from "@/components/Mermaid.astro";
import { languages, type LanguageKey } from "@/i18n/ui";
import {
  getLangFromUrl,
  getSlugFromId,
  useTranslatedPath,
  useTranslations,
} from "@/i18n/utils";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoriesByLang, postCategories, postsByLang } from "@/utils/posts.ts";
import { slugify } from "@/utils/slug";
import { render } from "astro:content";

export function getStaticPaths() {
  return (Object.keys(languages) as LanguageKey[]).flatMap((lang) =>
    postsByLang(lang)
      .filter((post) => !post.data.isDraft)
      .map((post) => ({
        params: { lang, slug: getSlugFromId(post.id) },
        props: { post },
      })),
  );
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const tableOfContents: Array<{
  depth: number;
  slug: string;
  text: string;
  children: typeof headings;
}> = [];
for (const heading of headings) {
  if (heading.depth === 1) {
    tableOfContents.push({ ...heading, children: [] });
  } else if (heading.depth === 2 || heading.depth === 3) {
    const section = tableOfContents[tableOfContents.length - 1];
    if (section) section.children.push(heading);
    else tableOfContents.push({ ...heading, children: [heading] });
  }
}
const { headline, subHeadline, excerpt, publishDate } = post.data;
const postCategoryList = postCategories(post);

const lang = getLangFromUrl(Astro.url);
const categories = categoriesByLang(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<BaseLayout title={headline} description={excerpt} type="article">
  <main class="px-4 pt-6 pb-12">
    <div class="md:flex md:gap-8">
      <div class="hidden md:block">
        <CategoryNav categories={categories} lang={lang} active={postCategoryList} />
      </div>
      <div class="md:min-w-0 md:flex-1">
        <article>
          <header>
            <p class="label flex flex-wrap items-center gap-x-1">
              {publishDate.toISOString().slice(0, 10)} · {postCategoryList.map((category, index) => (
                <>
                  {index > 0 && ", "}
                  <a href={`${translatePath(`/posts/categories/${slugify(category)}`)}/`}>{category}</a>
                </>
              ))}
            </p>
            <h1 class="mt-2 text-3xl tracking-tight md:text-4xl">{headline}</h1>
            <p class="mt-3 text-lg text-muted">{subHeadline}</p>
          </header>
          <div class="prose mt-8">
            <Content components={{ Mermaid }} />
          </div>
        </article>
      </div>
      {tableOfContents.length > 0 && (
        <aside class="hidden w-48 shrink-0 xl:block">
          <nav class="sticky top-8 max-h-[calc(100vh-4rem)] overflow-y-auto" aria-label="On this page">
            <p class="label mb-3">On this page</p>
            <ul class="space-y-3 pl-3 text-sm">
              {tableOfContents.map((section) => (
                <li>
                  <a class="font-medium hover:text-ink" href={`#${section.slug}`}>{section.text}</a>
                  {section.children.length > 0 && (
                    <ul class="mt-2 space-y-2 pl-3 text-muted">
                      {section.children.map((heading) => (
                        <li class={heading.depth === 3 ? "ml-3" : ""}>
                          <a class="hover:text-ink" href={`#${heading.slug}`}>{heading.text}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
    <Giscus />
  </main>
</BaseLayout>
